# Feuji Smart Healthcare Connector - Backend Environment Variables Example

# Server Configuration
SERVER_PORT=8080

# Database Configuration (PostgreSQL / NeonDB)
# For local postgres: jdbc:postgresql://localhost:5432/healthcare_connector
# For NeonDB: jdbc:postgresql://[host]/[dbname]?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/healthcare_connector
DB_USER=postgres
DB_PASSWORD=postgres

# JWT Configurations (HMAC-SHA 256-bit or 512-bit key, base64 encoded)
JWT_SECRET=dGhpcy1pcy1hLXNlY3JldC1rZXktZm9yLWNhcmVicmlkZ2UtYWktcGxhdGZvcm0tc2VjdXJlLWFuZC1kZW1vLWtleS1kb250LXVzZS1pbi1wcm9kdWN0aW9u

# Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP Configuration
# Create an App Password in Google account settings (2-Step Verification -> App Passwords)
GMAIL_USERNAME=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# Upstash Redis Configuration (Optional, for caching/rate-limiting)
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Cloudinary Configuration (Optional, for cloud media storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_URL=your_cloudinary_url


